---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getAllCategories } from '../data/categories';

const pageModules = import.meta.glob('./**/*.{astro,mdx}', { eager: true });

const recoveryUrls = new Set([
  '/',
  '/about/',
  '/affiliate-disclosure/',
  '/editorial-process/',
  '/sitemap/',
  '/beauty/',
  '/sports/',
  '/sleep/',
  '/vitamins/',
  '/mushroom/',
  '/weight-loss/',
  '/immunity/',
  '/trending/',
  '/candy/',
  '/blog/',
  '/best-creatine-gummies/',
  '/best-melatonin-gummies/',
  '/best-ashwagandha-gummies/',
  '/best-prenatal-gummies/',
  '/best-sea-moss-gummies/',
  '/best-sleep-gummies/',
  '/best-mushroom-gummies/',
  '/best-apple-cider-vinegar-gummies/',
  '/best-elderberry-gummies/',
  '/best-fiber-gummies/',
  '/best-iron-gummies/',
  '/best-gummies-for-women/',
  '/best-gummies-for-men/',
  '/gummies-vs-pills/',
  '/sugar-free-gummies/',
  '/vegan-gummies/',
]);

const hubUrls = [...getAllCategories().map((category) => category.prefix), '/blog/', '/candy/'];
const companyUrls = ['/about/', '/affiliate-disclosure/', '/contact/', '/editorial-process/', '/sitemap/'];

const sectionDefs = [
  { title: 'Core Buying Guides', test: (url: string) => url === '/' || (url.split('/').filter(Boolean).length === 1 && !companyUrls.includes(url) && !hubUrls.includes(url)) },
  ...getAllCategories().map((category) => ({
    title: category.name,
    test: (url: string) => url.startsWith(category.prefix),
  })),
  { title: 'Candy & Vegan Candy', test: (url: string) => url.startsWith('/candy/') },
  { title: 'Educational Blog', test: (url: string) => url.startsWith('/blog/') },
  { title: 'Company & Legal', test: (url: string) => companyUrls.includes(url) || url.startsWith('/legal/') },
];

const acronymMap: Record<string, string> = {
  acv: 'ACV',
  bcaa: 'BCAA',
  coq10: 'CoQ10',
  d3: 'D3',
  dha: 'DHA',
  fda: 'FDA',
  gaba: 'GABA',
  k2: 'K2',
  l: 'L',
  nmn: 'NMN',
  nr: 'NR',
};

function routeFromFile(file: string) {
  let route = file.replace(/^\.\//, '/').replace(/\.(astro|mdx)$/, '/');
  route = route.replace(/\/index\/$/, '/');
  return route;
}

function titleFromUrl(url: string) {
  if (url === '/') return 'GummyGuide Home';
  const slug = url.split('/').filter(Boolean).at(-1) || '';
  return slug
    .split('-')
    .map((word) => acronymMap[word] || word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')
    .replace('Vs', 'vs')
    .replace('And', 'and')
    .replace('For', 'for')
    .replace('With', 'with')
    .replace('Without', 'without');
}

const urls = Object.keys(pageModules)
  .map(routeFromFile)
  .filter((url) => recoveryUrls.has(url))
  .sort((a, b) => a.localeCompare(b));

const sections = sectionDefs
  .map((section) => ({
    title: section.title,
    links: urls
      .filter(section.test)
      .map((url) => ({ url, title: titleFromUrl(url) })),
  }))
  .filter((section) => section.links.length > 0);
---

<BaseLayout
  title="HTML Sitemap | GummyGuide"
  description="Browse the priority GummyGuide buying guides, supplement hubs, and company pages currently submitted for Google indexing."
  canonical="https://gummy-guide.com/sitemap/"
>
  <section class="pg-hero">
    <h1>GummyGuide Sitemap</h1>
    <p class="pg-sub">A focused crawlable index of the priority supplement gummy guides and hubs currently submitted for Google indexing.</p>
    <div class="pg-meta">
      <span>{urls.length} Pages</span>
      <span>Updated Automatically</span>
      <span>HTML Sitemap</span>
    </div>
  </section>

  <div class="w">
    <Breadcrumbs items={[{ label: 'Sitemap', href: '/sitemap/' }]} />

    <div class="callout">Use this page to jump directly to the priority GummyGuide resources currently submitted for indexing. Additional long-tail guides remain live and will be reintroduced in smaller batches.</div>

    {sections.map((section) => (
      <section class="sitemap-section">
        <h2>{section.title}</h2>
        <div class="sitemap-grid">
          {section.links.map((link) => (
            <a href={link.url} class="sitemap-link">{link.title}</a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
